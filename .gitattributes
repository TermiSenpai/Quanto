# Normalize line endings. Git decides text vs binary; checkout converts as needed.
* text=auto

# Explicit text files (always LF in the repo).
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

# Windows scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary — never normalize or diff.
*.png  binary
*.ico  binary
*.exe  binary
*.zip  binary
*.pdf  binary
*.pen  binary

# Generated / vendored — keep out of language stats and collapse in diffs.
package-lock.json   linguist-generated=true
devlog/**/*.svg     linguist-documentation=true
